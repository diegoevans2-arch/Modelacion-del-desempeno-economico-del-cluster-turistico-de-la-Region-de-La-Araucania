# =====================================================================
# Datos crudos: viven FUERA del repo (ver src/config.py / TESIS_BBDD_DIR).
# Si se copian dentro, van a BBDD/raw/ y no se versionan.
# =====================================================================
BBDD/raw/

# Formatos de datos crudos, en cualquier ubicación (evita subir fuentes pesadas)
*.csv
*.xls
*.xlsx
*.xlsb
*.rdata
*.RData

# ---------------------------------------------------------------------
# EXCEPCIÓN: los resultados de la investigación SÍ se versionan.
# Son livianos (~1,8 MB) y constituyen el producto reproducible del estudio:
# paneles integrados y resultados de las tres hipótesis.
# ---------------------------------------------------------------------
!BBDD/final/*.csv
!BBDD/processed/*.csv

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env

# R
.Rhistory

# Sistema
Thumbs.db
desktop.ini
.DS_Store

# Salidas regenerables
reports/figures/
